# wowweb configuration - copy to .env and adjust.
# Every value is read from the environment; see README.md for the full list.

# --- HTTP -------------------------------------------------------------------
WEB_LISTEN=:8080
# Set when serving through a reverse proxy that overwrites the client address.
WEB_TRUST_PROXY=false
# Set to true when the site is reachable over HTTPS.
SESSION_SECURE=false

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Create a dedicated user; see the "Database privileges" section in README.md.
DB_USER=wowweb
DB_PASSWORD=change-me

DB_LOGON_NAME=tw_logon
DB_WORLD_NAME=tw_world
DB_CHAR_NAME=tw_char
DB_LOGS_NAME=tw_logs

# --- Realm ------------------------------------------------------------------
# Must match RealmID in mangosd.conf.
REALM_ID=1
# Also used as the issuer shown in authenticator apps.
REALM_NAME=My Server

# Address clients use for the world server; shown on the home page and used as
# a hint when creating the realmlist row.
WORLD_ADDRESS=wow.example.com
WORLD_PORT=8090
REALM_PORT=3724

# --- Language ---------------------------------------------------------------
# Default UI language: "en" or "zh". A visitor's own choice (stored in the
# tw_lang cookie) or their browser's Accept-Language header takes precedence.
DEFAULT_LANG=zh

# --- Access control ---------------------------------------------------------
# account.rank needed for /admin: 4 = Administrator, 5 = SigmaChad.
ADMIN_MIN_RANK=4
ALLOW_REGISTER=true
REQUIRE_EMAIL=false
# 0 = unlimited.
MAX_ACCOUNTS=0
PASSWORD_MIN_LEN=6
SESSION_TTL_HOURS=168
